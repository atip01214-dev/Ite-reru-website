// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────────────────────────

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ─── Hero ───────────────────────────────────────────────────────────────────

model Hero {
  id              Int    @id @default(autoincrement())
  badge           String
  title           String
  subtitle        String
  tags            String // JSON array stored as string
  highlightCwie   String
  highlightIncome String
  ctaPrimary      String
  ctaAdmission    String
  bgImage         String
}

// ─── Stats ──────────────────────────────────────────────────────────────────

model Stat {
  id     Int    @id @default(autoincrement())
  value  Int
  suffix String
  label  String
  order  Int    @default(0)
}

// ─── About ──────────────────────────────────────────────────────────────────

model About {
  id            Int    @id @default(autoincrement())
  vision        String
  philosophy    String
  missionPoints String // JSON array
  ictValues     String // JSON array of {letter, term}
  awardBadge    String
}

// ─── Programs & Curriculum ──────────────────────────────────────────────────

model Program {
  id         Int     @id @default(autoincrement())
  degree     String
  name       String
  nameEn     String
  badge      String?
  duration   String?
  credits    String?
  highlights String? // JSON array
  majors     Major[]
  order      Int     @default(0)
}

model Major {
  id        Int     @id @default(autoincrement())
  programId Int
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  detail    String
  focus     String
  order     Int     @default(0)
}

model OtherProgram {
  id    Int    @id @default(autoincrement())
  name  String
  order Int    @default(0)
}

model Course {
  id     Int    @id @default(autoincrement())
  name   String
  nameEn String
  icon   String
  order  Int    @default(0)
}

model Career {
  id    Int    @id @default(autoincrement())
  name  String
  order Int    @default(0)
}

// ─── News ───────────────────────────────────────────────────────────────────

model News {
  id        Int      @id @default(autoincrement())
  category  String // "ข่าวประชาสัมพันธ์" | "กิจกรรมนักศึกษา" | "งานวิจัยและผลงาน"
  date      String
  title     String
  excerpt   String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Faculty ────────────────────────────────────────────────────────────────

model Faculty {
  id        Int      @id @default(autoincrement())
  name      String
  title     String
  degree    String
  image     String
  expertise String // JSON array
  link      String?
  isDean    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Facilities ─────────────────────────────────────────────────────────────

model Facility {
  id       Int    @id @default(autoincrement())
  name     String
  nameEn   String
  icon     String
  gradient String
  order    Int    @default(0)
}

// ─── Contact ────────────────────────────────────────────────────────────────

model Contact {
  id      Int    @id @default(autoincrement())
  faculty String
  address String
  phone   String
  fax     String
  email   String
  website String
}

// ─── Partners ───────────────────────────────────────────────────────────────

model Partner {
  id    Int    @id @default(autoincrement())
  name  String
  image String
  order Int    @default(0)
}

// ─── Nav Links ──────────────────────────────────────────────────────────────

model NavLink {
  id    Int    @id @default(autoincrement())
  label String
  href  String
  order Int    @default(0)
}
